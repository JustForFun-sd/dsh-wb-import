{
  "name": "dsh-wb-import",
  "version": "0.6.2",
  "description": "把 WorkBuddy 的历史会话导入 DeepSeek Harness（DSH）。带图形界面：浏览会话、勾选导入、选目标工作区、随时回滚；长会话可压缩导入——原文完整保留、随时向上翻看，发给模型的则是压缩后的上下文。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/会话格式修复记录.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "session",
    "import"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustForFun-sd/dsh-wb-import.git"
  },
  "bugs": {
    "url": "https://github.com/JustForFun-sd/dsh-wb-import/issues"
  },
  "homepage": "https://github.com/JustForFun-sd/dsh-wb-import#readme"
}
